<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QuadraLivre | Aluguel de Quadras</title>
    <link rel="stylesheet" href="estilos.css">
    <script src="script.js" defer></script>
</head>
<body>

    <header>
        <a href="#inicio" class="logo">Quadra<span>Livre</span></a>

        <nav>
            <a href="#inicio">Início</a>
            <a href="#quadras">Quadras</a>
            <a href="#reservar">Reservar</a>
        </nav>

        <a href="#reservar" class="botao">Reservar agora</a>
    </header>

    <main>
        <section class="banner" id="inicio">
            <div>
                <p class="destaque">ALUGUEL DE QUADRAS ESPORTIVAS</p>

                <h1>Jogue seu esporte<br>
                    <span>favorito aqui!</span>
                </h1>

                <p class="descricao">
                    Quadras de futebol, futsal, vôlei e basquete.
                    Escolha seu local e encontre um horário para jogar!
                </p>

                <a href="#quadras" class="botao">Encontrar quadras →</a>
            </div>
        </section>

        <section class="secao" id="quadras">
            <p class="destaque">NOSSAS QUADRAS</p>
            <h2>Escolha seu esporte</h2>

            <div class="filtros">
                <button class="filtro ativo" data-esporte="Todos">Todos</button>
                <button class="filtro" data-esporte="Futebol">Futebol</button>
                <button class="filtro" data-esporte="Futsal">Futsal</button>
                <button class="filtro" data-esporte="Vôlei">Vôlei</button>
                <button class="filtro" data-esporte="Basquete">Basquete</button>
            </div>

            <div class="quadras" id="lista-quadras"></div>
        </section>

        <section class="secao reserva" id="reservar">
            <p class="destaque">GARANTA SEU HORÁRIO</p>
            <h2>Faça sua reserva</h2>

            <form id="form-reserva">
                <label for="quadra">Escolha a quadra:</label>
                <select id="quadra" required></select>

                <label for="data">Escolha a data:</label>
                <input type="date" id="data" required>

                <label>Horários disponíveis:</label>
                <div id="horarios" class="horarios">
                    Escolha uma data para ver os horários.
                </div>

                <input type="hidden" id="horario-escolhido" required>

                <label for="nome">Seu nome:</label>
                <input type="text" id="nome"
                    placeholder="Digite seu nome" required>

                <label for="telefone">Telefone:</label>
                <input type="tel" id="telefone"
                    placeholder="(41) 99999-9999" required>

                <button type="submit" class="botao">
                    Solicitar reserva
                </button>
            </form>

            <div id="mensagem"></div>
        </section>
    </main>

    <footer>
        <a href="#inicio" class="logo">Quadra<span>Livre</span></a>
        <p>Seu esporte, seu horário, sua quadra.</p>
        <p>© 2026 QuadraLivre</p>
    </footer>

</body>
</html>
