<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="estilos.css">
    <title>Quadra Livre</title>
</head>
<body>
    

    <h1>Quadra Livre</h1>


    <img src="img/logo.jpg" alt="Logo">
    <h2>Reserva de arenas em tempo real, divisão automática do pagamento entre os jogadores e gerenciamento de listas de espera.</h2>
    <h3>Faça já sua reserva!</h3>
    <ul id="lista-esportes">
    <li><button onclick="mostrarHorarios('Fut7')">Fut7</button></li>
    <li><button onclick="mostrarHorarios('Futsal')">Futsal</button></li>
    <li><button onclick="mostrarHorarios('Tênis')">Tênis</button></li>
    <li><button onclick="mostrarHorarios('Padel')">Padel</button></li>
    <li><button onclick="mostrarHorarios('Futevôlei')">Futevôlei</button></li>
    <li><button onclick="mostrarHorarios('Beach Tennis')">Beach Tennis</button></li>
    <li><button onclick="mostrarHorarios('Vôlei de Praia')">Vôlei de Praia</button></li>
    <li><button onclick="mostrarHorarios('Basquete')">Basquete</button></li>
</ul>

<section id="area-horarios" hidden>
    <h2 id="titulo-esporte"></h2>

    <label for="data-reserva">Escolha a data:</label>
    <input type="date" id="data-reserva">

    <h3>Endereços / Arenas disponíveis</h3>
    <div id="lista-enderecos"></div>

    <h3>Horários disponíveis</h3>
    <div id="horarios"></div>
</section>

<script src="script.js"></script>


    <footer>Contato: quadralivre@gmail.com</footer>
</body>
</html>
