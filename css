h1{
    text-align: center;
    background-color: rgb(11, 77, 31);
    padding: 40px;
}
*{
    font-family: Arial, Helvetica, sans-serif;
    background-color: rgb(7, 56, 7);
    color: white;
    margin: 0;
}
ul{
    padding: 15px;
    line-height: 40px;
    margin-left: 40px;
    font-size: 25px;
    padding: 15px;
}
footer{
    font-size: 25px;
    text-align: center;
    background-color: rgb(11, 77, 31);
    padding: 40px;
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
}
h2{
    padding: 30px;
}
h3{
    padding: 30px;
    font-size: 25px;
}
img{
    display: block;
    margin-left: auto;
    margin-right: auto;
    margin-top: 30px;
    width: 350px;
    height: 280px;
}

#lista-esportes {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    list-style: none;
    padding: 0;
}

#lista-esportes button,
.horario {
    background-color: #16834a;
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 16px;
    margin: 5px;
}

#lista-esportes button:hover,
.horario:hover {
    background-color: #0e5c33;
}

#area-horarios {
    margin-top: 30px;
    padding: 24px;
    background-color: #f2f5f3;
    border-radius: 12px;
}

#area-horarios[hidden] {
    display: none;
}

#data-reserva {
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 6px;
}

#horarios {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

